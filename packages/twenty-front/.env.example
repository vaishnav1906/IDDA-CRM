REACT_APP_SERVER_BASE_URL=http://localhost:3000
VITE_BUILD_SOURCEMAP=false


# ———————— Google Maps ————————
# Required for the embedded map picker in Leads (Select Location on Map).
# Required Google Cloud APIs: Maps JavaScript API, Places API, Geocoding API
# Restrict this browser key by HTTP referrer in Google Cloud Console.
# REACT_APP_GOOGLE_MAPS_API_KEY=

# ———————— Optional ————————
# REACT_APP_PORT=3001
# VITE_ENABLE_SSL=false
# VITE_HOST=localhost.com
# SSL_KEY_PATH="./certs/your-cert.key"
# SSL_CERT_PATH="./certs/your-cert.crt"
# IS_DEBUG_MODE=false